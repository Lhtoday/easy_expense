generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum MasterDataStatus {
  ACTIVE
  DISABLED
}

enum DataScopeType {
  ALL
  OWN_DEPARTMENT
  OWN
  CUSTOM
}

enum ExpenseReportStatus {
  DRAFT
  SUBMITTED
  BUSINESS_APPROVED
  FINANCE_APPROVED
  FINANCE_REJECTED
  APPROVED
  REJECTED
  VOIDED
}

enum ExpenseReportAction {
  CREATE
  UPDATE
  SUBMIT
  WITHDRAW
  APPROVE
  REJECT
  FINANCE_APPROVE
  FINANCE_RETURN
  FINANCE_REJECT
  VOID
}

enum FinanceReviewAction {
  APPROVE
  RETURN
  REJECT
}

enum ApprovalFlowConfigStatus {
  ACTIVE
  DISABLED
}

enum ApprovalInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalAction {
  CREATE
  APPROVE
  REJECT
  WITHDRAW
}

enum ExpenseAttachmentCategory {
  GENERAL
  INVOICE_IMAGE
  PAYMENT_PROOF
  OTHER
}

enum InvoiceDuplicateStatus {
  UNIQUE
  DUPLICATE
}

enum ExpensePolicyStatus {
  ACTIVE
  DISABLED
}

enum ExpensePolicyAction {
  WARNING
  BLOCK
  ESCALATE
}

enum ExpensePolicyCheckResult {
  PASS
  WARNING
  BLOCK
  ESCALATE
}

enum BudgetStatus {
  ACTIVE
  DISABLED
}

enum BudgetControlMode {
  WARNING
  BLOCK
}

enum BudgetOccupationStatus {
  IN_TRANSIT
  APPROVED
  ACTUAL
  RELEASED
}

enum BudgetAction {
  OCCUPY_IN_TRANSIT
  RELEASE
  CONFIRM_APPROVED
  TRANSFER_ACTUAL
  ADJUST
}

enum BudgetCheckResult {
  PASS
  WARNING
  BLOCK
}

model User {
  id             String             @id @default(cuid())
  employeeNo     String             @unique @map("employee_no")
  email          String             @unique
  name           String
  passwordHash   String             @map("password_hash")
  status         UserStatus         @default(ACTIVE)
  departmentId   String?            @map("department_id")
  costCenterId   String?            @map("cost_center_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")
  department     Department?        @relation(fields: [departmentId], references: [id])
  costCenter     CostCenter?        @relation(fields: [costCenterId], references: [id])
  roles          UserRole[]
  createdReports ExpenseReport[]    @relation("ExpenseReportApplicant")
  updatedReports ExpenseReport[]    @relation("ExpenseReportUpdater")
  reportLogs     ExpenseReportLog[]
  uploadedAttachments ExpenseAttachment[] @relation("ExpenseAttachmentUploader")
  invoiceCreatedBy ExpenseInvoice[]       @relation("ExpenseInvoiceCreator")
  assignedApprovalTasks ExpenseApprovalTask[] @relation("ApprovalTaskAssignee")
  operatedApprovalLogs  ExpenseApprovalLog[]  @relation("ApprovalLogOperator")
  createdBudgets        Budget[]              @relation("BudgetCreator")
  updatedBudgets        Budget[]              @relation("BudgetUpdater")
  operatedBudgetLogs    BudgetOperationLog[]  @relation("BudgetLogOperator")
  operatedFinanceReviews ExpenseFinanceReview[] @relation("FinanceReviewOperator")

  @@map("iam_users")
}

model Role {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  status      RoleStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")
  users       UserRole[]
  permissions RolePermission[]
  dataScopes  DataScope[]

  @@map("iam_roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("iam_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("iam_user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("iam_role_permissions")
}

model DataScope {
  id           String        @id @default(cuid())
  roleId       String        @map("role_id")
  resource     String
  scopeType    DataScopeType @map("scope_type")
  departmentId String?       @map("department_id")
  costCenterId String?       @map("cost_center_id")
  projectId    String?       @map("project_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  role         Role          @relation(fields: [roleId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  costCenter   CostCenter?   @relation(fields: [costCenterId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])

  @@unique([roleId, resource])
  @@map("iam_data_scopes")
}

model Department {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  parentId    String?          @map("parent_id")
  status      MasterDataStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  parent      Department?      @relation("DepartmentTree", fields: [parentId], references: [id])
  children    Department[]     @relation("DepartmentTree")
  users       User[]
  costCenters CostCenter[]
  projects    Project[]
  dataScopes  DataScope[]
  expenseReports ExpenseReport[]
  expenseItems   ExpenseReportItem[]
  budgets        Budget[]

  @@map("md_departments")
}

model CostCenter {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  departmentId String?          @map("department_id")
  status       MasterDataStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  department   Department?      @relation(fields: [departmentId], references: [id])
  users        User[]
  projects     Project[]
  dataScopes   DataScope[]
  expenseReports ExpenseReport[]
  expenseItems   ExpenseReportItem[]
  budgets        Budget[]

  @@map("md_cost_centers")
}

model Project {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  ownerUserId  String?          @map("owner_user_id")
  departmentId String?          @map("department_id")
  costCenterId String?          @map("cost_center_id")
  status       MasterDataStatus @default(ACTIVE)
  startsAt     DateTime?        @map("starts_at")
  endsAt       DateTime?        @map("ends_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  department   Department?      @relation(fields: [departmentId], references: [id])
  costCenter   CostCenter?      @relation(fields: [costCenterId], references: [id])
  dataScopes   DataScope[]
  expenseReports ExpenseReport[]
  expenseItems   ExpenseReportItem[]
  budgets        Budget[]

  @@map("md_projects")
}

model ExpenseType {
  id                        String           @id @default(cuid())
  code                      String           @unique
  name                      String
  description               String?
  status                    MasterDataStatus @default(ACTIVE)
  defaultAccountSubjectCode String?          @map("default_account_subject_code")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  deletedAt                 DateTime?        @map("deleted_at")

  @@map("md_expense_types")
}

model ExpenseReport {
  id                    String                @id @default(cuid())
  reportNo              String                @unique @map("report_no")
  title                 String
  applicantId           String                @map("applicant_id")
  departmentId          String?               @map("department_id")
  costCenterId          String?               @map("cost_center_id")
  projectId             String?               @map("project_id")
  status                ExpenseReportStatus   @default(DRAFT)
  currency              String                @default("CNY")
  amountCents           Int                   @default(0) @map("amount_cents")
  taxAmountCents        Int                   @default(0) @map("tax_amount_cents")
  deductibleTaxCents    Int                   @default(0) @map("deductible_tax_cents")
  reimbursableCents     Int                   @default(0) @map("reimbursable_cents")
  paidAmountCents       Int                   @default(0) @map("paid_amount_cents")
  submittedAt           DateTime?             @map("submitted_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  deletedAt             DateTime?             @map("deleted_at")
  applicant             User                  @relation("ExpenseReportApplicant", fields: [applicantId], references: [id])
  updatedById           String?               @map("updated_by")
  updatedBy             User?                 @relation("ExpenseReportUpdater", fields: [updatedById], references: [id])
  department            Department?           @relation(fields: [departmentId], references: [id])
  costCenter            CostCenter?           @relation(fields: [costCenterId], references: [id])
  project               Project?              @relation(fields: [projectId], references: [id])
  items                 ExpenseReportItem[]
  logs                  ExpenseReportLog[]
  attachments           ExpenseAttachment[]
  invoices              ExpenseInvoice[]
  approvalInstances     ExpenseApprovalInstance[]
  approvalTasks         ExpenseApprovalTask[]
  policyChecks          ExpensePolicyCheck[]
  budgetOccupations     BudgetOccupation[]
  budgetChecks          ExpenseBudgetCheck[]
  financeReviews        ExpenseFinanceReview[]

  @@index([applicantId, status])
  @@index([departmentId])
  @@index([costCenterId])
  @@index([projectId])
  @@map("exp_reports")
}

model ExpenseApprovalFlowConfig {
  id            String                   @id @default(cuid())
  code          String                   @unique
  name          String
  description   String?
  approverRoleCode String                @map("approver_role_code")
  status        ApprovalFlowConfigStatus @default(ACTIVE)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  instances     ExpenseApprovalInstance[]

  @@map("exp_approval_flow_configs")
}

model ExpensePolicy {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  description   String?
  status        ExpensePolicyStatus @default(ACTIVE)
  effectiveFrom DateTime?           @map("effective_from")
  effectiveTo   DateTime?           @map("effective_to")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")
  rules         ExpensePolicyRule[]
  checks        ExpensePolicyCheck[]

  @@map("exp_policies")
}

model ExpensePolicyRule {
  id                  String              @id @default(cuid())
  policyId            String              @map("policy_id")
  code                String
  name                String
  description         String?
  expenseTypeCode     String?             @map("expense_type_code")
  city                String?
  jobLevel            String?             @map("job_level")
  maxAmountCents      Int?                @map("max_amount_cents")
  requiresInvoice     Boolean             @default(false) @map("requires_invoice")
  requiresPreApproval Boolean             @default(false) @map("requires_pre_approval")
  action              ExpensePolicyAction @default(WARNING)
  status              ExpensePolicyStatus @default(ACTIVE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  policy              ExpensePolicy       @relation(fields: [policyId], references: [id])
  checks              ExpensePolicyCheck[]

  @@unique([policyId, code])
  @@index([expenseTypeCode])
  @@map("exp_policy_rules")
}

model ExpenseApprovalInstance {
  id          String                 @id @default(cuid())
  reportId    String                 @map("report_id")
  flowConfigId String                @map("flow_config_id")
  status      ApprovalInstanceStatus @default(IN_PROGRESS)
  startedById String                 @map("started_by")
  startedAt   DateTime               @default(now()) @map("started_at")
  completedAt DateTime?              @map("completed_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  report      ExpenseReport          @relation(fields: [reportId], references: [id])
  flowConfig  ExpenseApprovalFlowConfig @relation(fields: [flowConfigId], references: [id])
  tasks       ExpenseApprovalTask[]
  logs        ExpenseApprovalLog[]

  @@index([reportId, status])
  @@index([flowConfigId])
  @@map("exp_approval_instances")
}

model ExpenseApprovalTask {
  id          String             @id @default(cuid())
  instanceId  String             @map("instance_id")
  reportId    String             @map("report_id")
  nodeCode    String             @map("node_code")
  nodeName    String             @map("node_name")
  assigneeId  String             @map("assignee_id")
  status      ApprovalTaskStatus @default(PENDING)
  comment     String?
  createdAt   DateTime           @default(now()) @map("created_at")
  completedAt DateTime?          @map("completed_at")
  instance    ExpenseApprovalInstance @relation(fields: [instanceId], references: [id])
  report      ExpenseReport      @relation(fields: [reportId], references: [id])
  assignee    User               @relation("ApprovalTaskAssignee", fields: [assigneeId], references: [id])
  logs        ExpenseApprovalLog[]

  @@index([assigneeId, status])
  @@index([reportId])
  @@index([instanceId])
  @@map("exp_approval_tasks")
}

model ExpenseApprovalLog {
  id          String         @id @default(cuid())
  instanceId  String         @map("instance_id")
  taskId      String?        @map("task_id")
  operatorId  String         @map("operator_id")
  action      ApprovalAction
  fromStatus  ApprovalTaskStatus? @map("from_status")
  toStatus    ApprovalTaskStatus? @map("to_status")
  comment     String?
  createdAt   DateTime       @default(now()) @map("created_at")
  instance    ExpenseApprovalInstance @relation(fields: [instanceId], references: [id])
  task        ExpenseApprovalTask?    @relation(fields: [taskId], references: [id])
  operator    User           @relation("ApprovalLogOperator", fields: [operatorId], references: [id])

  @@index([instanceId])
  @@index([taskId])
  @@index([operatorId])
  @@map("exp_approval_logs")
}

model ExpenseReportItem {
  id                    String        @id @default(cuid())
  reportId              String        @map("report_id")
  occurredAt            DateTime      @map("occurred_at")
  expenseTypeCode       String        @map("expense_type_code")
  accountSubjectCode    String?       @map("account_subject_code")
  description           String
  departmentId          String?       @map("department_id")
  costCenterId          String?       @map("cost_center_id")
  projectId             String?       @map("project_id")
  amountCents           Int           @map("amount_cents")
  taxAmountCents        Int           @default(0) @map("tax_amount_cents")
  deductibleTaxCents    Int           @default(0) @map("deductible_tax_cents")
  reimbursableCents     Int           @map("reimbursable_cents")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  report                ExpenseReport @relation(fields: [reportId], references: [id])
  department            Department?   @relation(fields: [departmentId], references: [id])
  costCenter            CostCenter?   @relation(fields: [costCenterId], references: [id])
  project               Project?      @relation(fields: [projectId], references: [id])
  invoices              ExpenseInvoice[]
  policyChecks          ExpensePolicyCheck[]
  budgetOccupations     BudgetOccupation[]
  budgetChecks          ExpenseBudgetCheck[]

  @@index([reportId])
  @@map("exp_report_items")
}

model ExpensePolicyCheck {
  id        String                   @id @default(cuid())
  reportId  String                   @map("report_id")
  itemId    String?                  @map("item_id")
  policyId  String?                  @map("policy_id")
  ruleId    String?                  @map("rule_id")
  result    ExpensePolicyCheckResult
  message   String
  createdAt DateTime                 @default(now()) @map("created_at")
  report    ExpenseReport            @relation(fields: [reportId], references: [id])
  item      ExpenseReportItem?       @relation(fields: [itemId], references: [id])
  policy    ExpensePolicy?           @relation(fields: [policyId], references: [id])
  rule      ExpensePolicyRule?       @relation(fields: [ruleId], references: [id])

  @@index([reportId, result])
  @@index([itemId])
  @@index([ruleId])
  @@map("exp_policy_checks")
}

model Budget {
  id                    String            @id @default(cuid())
  code                  String            @unique
  name                  String
  fiscalPeriod          String            @map("fiscal_period")
  departmentId          String?           @map("department_id")
  costCenterId          String?           @map("cost_center_id")
  projectId             String?           @map("project_id")
  expenseTypeCode       String?           @map("expense_type_code")
  accountSubjectCode    String?           @map("account_subject_code")
  currency              String            @default("CNY")
  totalCents            Int               @map("total_cents")
  inTransitCents        Int               @default(0) @map("in_transit_cents")
  approvedCents         Int               @default(0) @map("approved_cents")
  actualCents           Int               @default(0) @map("actual_cents")
  warningThresholdBps   Int               @default(9000) @map("warning_threshold_bps")
  controlMode           BudgetControlMode @default(WARNING) @map("control_mode")
  status                BudgetStatus      @default(ACTIVE)
  createdById           String            @map("created_by")
  updatedById           String?           @map("updated_by")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  department            Department?       @relation(fields: [departmentId], references: [id])
  costCenter            CostCenter?       @relation(fields: [costCenterId], references: [id])
  project               Project?          @relation(fields: [projectId], references: [id])
  createdBy             User              @relation("BudgetCreator", fields: [createdById], references: [id])
  updatedBy             User?             @relation("BudgetUpdater", fields: [updatedById], references: [id])
  occupations           BudgetOccupation[]
  checks                ExpenseBudgetCheck[]
  logs                  BudgetOperationLog[]

  @@index([fiscalPeriod, status])
  @@index([departmentId])
  @@index([costCenterId])
  @@index([projectId])
  @@index([expenseTypeCode])
  @@unique([fiscalPeriod, departmentId, costCenterId, projectId, expenseTypeCode, accountSubjectCode, currency])
  @@map("bud_budgets")
}

model BudgetOccupation {
  id                    String                 @id @default(cuid())
  budgetId              String                 @map("budget_id")
  reportId              String                 @map("report_id")
  itemId                String                 @map("item_id")
  status                BudgetOccupationStatus @default(IN_TRANSIT)
  fiscalPeriod          String                 @map("fiscal_period")
  departmentId          String?                @map("department_id")
  costCenterId          String?                @map("cost_center_id")
  projectId             String?                @map("project_id")
  expenseTypeCode       String                 @map("expense_type_code")
  accountSubjectCode    String?                @map("account_subject_code")
  currency              String                 @default("CNY")
  occupiedCents         Int                    @map("occupied_cents")
  approvedCents         Int                    @default(0) @map("approved_cents")
  actualCents           Int                    @default(0) @map("actual_cents")
  releasedCents         Int                    @default(0) @map("released_cents")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  releasedAt            DateTime?              @map("released_at")
  budget                Budget                 @relation(fields: [budgetId], references: [id])
  report                ExpenseReport          @relation(fields: [reportId], references: [id])
  item                  ExpenseReportItem      @relation(fields: [itemId], references: [id])
  logs                  BudgetOperationLog[]

  @@index([budgetId, status])
  @@index([reportId, status])
  @@index([itemId])
  @@map("bud_occupations")
}

model ExpenseBudgetCheck {
  id          String            @id @default(cuid())
  reportId    String            @map("report_id")
  itemId      String?           @map("item_id")
  budgetId    String?           @map("budget_id")
  result      BudgetCheckResult
  message     String
  createdAt   DateTime          @default(now()) @map("created_at")
  report      ExpenseReport     @relation(fields: [reportId], references: [id])
  item        ExpenseReportItem? @relation(fields: [itemId], references: [id])
  budget      Budget?           @relation(fields: [budgetId], references: [id])

  @@index([reportId, result])
  @@index([budgetId])
  @@map("bud_checks")
}

model BudgetOperationLog {
  id            String            @id @default(cuid())
  budgetId      String            @map("budget_id")
  occupationId  String?           @map("occupation_id")
  operatorId    String            @map("operator_id")
  action        BudgetAction
  amountCents   Int               @map("amount_cents")
  beforeInTransitCents Int         @map("before_in_transit_cents")
  afterInTransitCents  Int         @map("after_in_transit_cents")
  beforeApprovedCents  Int         @map("before_approved_cents")
  afterApprovedCents   Int         @map("after_approved_cents")
  beforeActualCents    Int         @map("before_actual_cents")
  afterActualCents     Int         @map("after_actual_cents")
  comment       String?
  createdAt     DateTime          @default(now()) @map("created_at")
  budget        Budget            @relation(fields: [budgetId], references: [id])
  occupation    BudgetOccupation? @relation(fields: [occupationId], references: [id])
  operator      User              @relation("BudgetLogOperator", fields: [operatorId], references: [id])

  @@index([budgetId])
  @@index([occupationId])
  @@index([operatorId])
  @@map("bud_operation_logs")
}

model ExpenseFinanceReview {
  id          String              @id @default(cuid())
  reportId    String              @map("report_id")
  operatorId  String              @map("operator_id")
  action      FinanceReviewAction
  fromStatus  ExpenseReportStatus @map("from_status")
  toStatus    ExpenseReportStatus @map("to_status")
  comment     String?
  createdAt   DateTime            @default(now()) @map("created_at")
  report      ExpenseReport       @relation(fields: [reportId], references: [id])
  operator    User                @relation("FinanceReviewOperator", fields: [operatorId], references: [id])

  @@index([reportId])
  @@index([operatorId])
  @@map("exp_finance_reviews")
}

model ExpenseAttachment {
  id              String                    @id @default(cuid())
  reportId        String                    @map("report_id")
  fileName        String                    @map("file_name")
  mimeType        String                    @map("mime_type")
  sizeBytes       Int                       @map("size_bytes")
  storageBucket   String                    @map("storage_bucket")
  storageKey      String                    @map("storage_key")
  category        ExpenseAttachmentCategory @default(GENERAL)
  uploadedById    String                    @map("uploaded_by")
  createdAt       DateTime                  @default(now()) @map("created_at")
  deletedAt       DateTime?                 @map("deleted_at")
  report          ExpenseReport             @relation(fields: [reportId], references: [id])
  uploadedBy      User                      @relation("ExpenseAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([reportId])
  @@index([uploadedById])
  @@map("exp_attachments")
}

model ExpenseInvoice {
  id                    String                 @id @default(cuid())
  reportId              String                 @map("report_id")
  itemId                String?                @map("item_id")
  invoiceCode           String?                @map("invoice_code")
  invoiceNo             String                 @map("invoice_no")
  issuedAt              DateTime               @map("issued_at")
  sellerName            String                 @map("seller_name")
  sellerTaxNo           String?                @map("seller_tax_no")
  buyerName             String?                @map("buyer_name")
  buyerTaxNo            String?                @map("buyer_tax_no")
  amountCents           Int                    @map("amount_cents")
  taxAmountCents        Int                    @default(0) @map("tax_amount_cents")
  deductibleTaxCents    Int                    @default(0) @map("deductible_tax_cents")
  totalAmountCents      Int                    @map("total_amount_cents")
  currency              String                 @default("CNY")
  duplicateStatus       InvoiceDuplicateStatus @default(UNIQUE) @map("duplicate_status")
  duplicateOfId         String?                @map("duplicate_of_id")
  createdById           String                 @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  report                ExpenseReport          @relation(fields: [reportId], references: [id])
  item                  ExpenseReportItem?     @relation(fields: [itemId], references: [id])
  duplicateOf           ExpenseInvoice?        @relation("InvoiceDuplicate", fields: [duplicateOfId], references: [id])
  duplicates            ExpenseInvoice[]       @relation("InvoiceDuplicate")
  createdBy             User                   @relation("ExpenseInvoiceCreator", fields: [createdById], references: [id])

  @@index([reportId])
  @@index([itemId])
  @@index([createdById])
  @@index([invoiceCode, invoiceNo, issuedAt, totalAmountCents, sellerName])
  @@map("exp_invoices")
}

model ExpenseReportLog {
  id          String              @id @default(cuid())
  reportId    String              @map("report_id")
  operatorId  String              @map("operator_id")
  action      ExpenseReportAction
  fromStatus  ExpenseReportStatus? @map("from_status")
  toStatus    ExpenseReportStatus  @map("to_status")
  comment     String?
  createdAt   DateTime            @default(now()) @map("created_at")
  report      ExpenseReport       @relation(fields: [reportId], references: [id])
  operator    User                @relation(fields: [operatorId], references: [id])

  @@index([reportId])
  @@index([operatorId])
  @@map("exp_report_logs")
}
